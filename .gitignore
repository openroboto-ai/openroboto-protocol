# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Tool output. `.coverage` (a 53 KB sqlite file) and `.mypy_cache/` (a few MB) are
# produced by a normal run and sit in the working tree. Unlisted, they get committed
# and stay in history, where deleting them later does not remove them.
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# ── Trellis / Claude Code local workflow ─────────────────
# Runtime state of internal dev tooling: task queues, session journals, agent
# scratch. It is machine-local and changes on every run, so it is not history.
# The conventions themselves stay tracked in AGENTS.md / CLAUDE.md, which are
# what a reader of this repo actually needs.
.trellis/
.claude/
