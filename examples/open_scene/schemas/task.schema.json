{
  "$defs": {
    "JsonValue": {},
    "_Asset": {
      "additionalProperties": false,
      "description": "Compound asset identity includes geometry, physics, symmetry and provenance.",
      "properties": {
        "collision": {
          "$ref": "#/$defs/_Geometry"
        },
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,31}$",
          "title": "Id",
          "type": "string"
        },
        "physics": {
          "$ref": "#/$defs/_Physics"
        },
        "provenance": {
          "$ref": "#/$defs/_Provenance"
        },
        "symmetry": {
          "$ref": "#/$defs/_Symmetry"
        },
        "version": {
          "maxLength": 1000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Version",
          "type": "string"
        },
        "visual": {
          "$ref": "#/$defs/_Geometry"
        }
      },
      "required": [
        "digest",
        "id",
        "version",
        "visual",
        "collision",
        "physics",
        "symmetry",
        "provenance"
      ],
      "title": "_Asset",
      "type": "object"
    },
    "_Camera": {
      "additionalProperties": false,
      "description": "Exact render camera and calibration; no state coordinates in vision mode.",
      "properties": {
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "frame": {
          "pattern": "^[a-z][a-z0-9_]{0,31}$",
          "title": "Frame",
          "type": "string"
        },
        "image_size": {
          "items": {
            "exclusiveMinimum": 0,
            "type": "integer"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Image Size",
          "type": "array"
        },
        "name": {
          "maxLength": 1000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Name",
          "type": "string"
        },
        "pose_in_frame": {
          "$ref": "#/$defs/_Pose"
        },
        "vertical_fov_deg": {
          "exclusiveMaximum": 180,
          "exclusiveMinimum": 0,
          "title": "Vertical Fov Deg",
          "type": "number"
        }
      },
      "required": [
        "digest",
        "name",
        "frame",
        "pose_in_frame",
        "vertical_fov_deg",
        "image_size"
      ],
      "title": "_Camera",
      "type": "object"
    },
    "_ContactPhysics": {
      "additionalProperties": false,
      "properties": {
        "contact_dimension": {
          "maximum": 6,
          "minimum": 1,
          "title": "Contact Dimension",
          "type": "integer"
        },
        "friction": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Friction",
          "type": "array"
        }
      },
      "required": [
        "friction",
        "contact_dimension"
      ],
      "title": "_ContactPhysics",
      "type": "object"
    },
    "_ContactTarget": {
      "additionalProperties": false,
      "description": "Named subset of an entity's geoms; aliases may overlap, ownership may not.",
      "properties": {
        "entity_id": {
          "pattern": "^[a-z][a-z0-9_]{0,31}$",
          "title": "Entity Id",
          "type": "string"
        },
        "geom_names": {
          "items": {
            "maxLength": 1000,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 1,
          "title": "Geom Names",
          "type": "array"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,31}$",
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "entity_id",
        "geom_names"
      ],
      "title": "_ContactTarget",
      "type": "object"
    },
    "_Definition": {
      "additionalProperties": false,
      "properties": {
        "invariants": {
          "items": {
            "additionalProperties": {
              "$ref": "#/$defs/JsonValue"
            },
            "type": "object"
          },
          "title": "Invariants",
          "type": "array"
        },
        "objects": {
          "items": {
            "$ref": "#/$defs/_Object"
          },
          "minItems": 1,
          "title": "Objects",
          "type": "array"
        },
        "observation": {
          "enum": [
            "state",
            "vision"
          ],
          "title": "Observation",
          "type": "string"
        },
        "resource_profile": {
          "maxLength": 1000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Resource Profile",
          "type": "string"
        },
        "stages": {
          "items": {
            "$ref": "#/$defs/_Stage"
          },
          "title": "Stages",
          "type": "array"
        },
        "template": {
          "const": "imported_scene",
          "title": "Template",
          "type": "string"
        },
        "zones": {
          "items": {
            "$ref": "#/$defs/_Zone"
          },
          "title": "Zones",
          "type": "array"
        }
      },
      "required": [
        "template",
        "objects",
        "zones",
        "stages",
        "invariants",
        "observation",
        "resource_profile"
      ],
      "title": "_Definition",
      "type": "object"
    },
    "_Dependency": {
      "additionalProperties": false,
      "description": "An already materialized file and its direct package-relative dependencies.",
      "properties": {
        "license": {
          "maxLength": 1000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "License",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "requires": {
          "items": {
            "type": "string"
          },
          "title": "Requires",
          "type": "array"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "source": {
          "maxLength": 1000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Source",
          "type": "string"
        },
        "source_revision": {
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
          "title": "Source Revision",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes",
        "requires",
        "source",
        "source_revision",
        "license"
      ],
      "title": "_Dependency",
      "type": "object"
    },
    "_ExactRef": {
      "additionalProperties": false,
      "description": "One inseparable id/version/content reference; no floating dependency.",
      "properties": {
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "id": {
          "maxLength": 1000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Id",
          "type": "string"
        },
        "version": {
          "maxLength": 1000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "digest"
      ],
      "title": "_ExactRef",
      "type": "object"
    },
    "_Frame": {
      "additionalProperties": false,
      "description": "Reset-reference child origin/axes in its parent; world is implicit identity.",
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,31}$",
          "title": "Id",
          "type": "string"
        },
        "parent": {
          "pattern": "^[a-z][a-z0-9_]{0,31}$",
          "title": "Parent",
          "type": "string"
        },
        "pose_in_parent": {
          "$ref": "#/$defs/_Pose"
        }
      },
      "required": [
        "id",
        "parent",
        "pose_in_parent"
      ],
      "title": "_Frame",
      "type": "object"
    },
    "_Geometry": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "parts": {
          "items": {
            "$ref": "#/$defs/_GeometryPart"
          },
          "minItems": 1,
          "title": "Parts",
          "type": "array"
        }
      },
      "required": [
        "digest",
        "parts"
      ],
      "title": "_Geometry",
      "type": "object"
    },
    "_GeometryPart": {
      "additionalProperties": false,
      "description": "Actual shapes in asset coordinates; sizes follow MuJoCo conventions.\n\nBox: half-extents. Sphere: radius. Cylinder/capsule: radius and straight\nhalf-length (excluding cap radius). Mesh: XYZ scale, plus materialized path.",
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,31}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "box",
            "sphere",
            "cylinder",
            "capsule",
            "mesh"
          ],
          "title": "Kind",
          "type": "string"
        },
        "mesh_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Mesh Path"
        },
        "pose_in_asset": {
          "$ref": "#/$defs/_Pose"
        },
        "size": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Size",
          "type": "array"
        }
      },
      "required": [
        "id",
        "kind",
        "size",
        "mesh_path",
        "pose_in_asset"
      ],
      "title": "_GeometryPart",
      "type": "object"
    },
    "_InitialState": {
      "additionalProperties": false,
      "description": "Materialized initial states; every registered state is retained on failure.",
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,31}$",
          "title": "Id",
          "type": "string"
        },
        "joints": {
          "items": {
            "$ref": "#/$defs/_JointState"
          },
          "title": "Joints",
          "type": "array"
        },
        "objects": {
          "items": {
            "$ref": "#/$defs/_ObjectState"
          },
          "title": "Objects",
          "type": "array"
        }
      },
      "required": [
        "id",
        "objects",
        "joints"
      ],
      "title": "_InitialState",
      "type": "object"
    },
    "_Joint": {
      "additionalProperties": false,
      "description": "Passive scalar joint identity, checked against the actual compiled model.",
      "properties": {
        "axis_in_child_body": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Axis In Child Body",
          "type": "array"
        },
        "body_id": {
          "pattern": "^[a-z][a-z0-9_]{0,31}$",
          "title": "Body Id",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,31}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "hinge",
            "slide"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "maxLength": 1000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Name",
          "type": "string"
        },
        "parent_body": {
          "maxLength": 1000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Parent Body",
          "type": "string"
        },
        "range": {
          "items": {
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Range",
          "type": "array"
        },
        "unit": {
          "enum": [
            "rad",
            "m"
          ],
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "body_id",
        "parent_body",
        "kind",
        "axis_in_child_body",
        "range",
        "unit"
      ],
      "title": "_Joint",
      "type": "object"
    },
    "_JointState": {
      "additionalProperties": false,
      "properties": {
        "joint_id": {
          "pattern": "^[a-z][a-z0-9_]{0,31}$",
          "title": "Joint Id",
          "type": "string"
        },
        "position": {
          "title": "Position",
          "type": "number"
        }
      },
      "required": [
        "joint_id",
        "position"
      ],
      "title": "_JointState",
      "type": "object"
    },
    "_Object": {
      "additionalProperties": false,
      "description": "Explicit geometry ownership on one real body; descendants are never implicit.",
      "properties": {
        "asset": {
          "$ref": "#/$defs/_ExactRef"
        },
        "asset_pose_in_body": {
          "$ref": "#/$defs/_Pose"
        },
        "body": {
          "maxLength": 1000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Body",
          "type": "string"
        },
        "body_frame": {
          "pattern": "^[a-z][a-z0-9_]{0,31}$",
          "title": "Body Frame",
          "type": "string"
        },
        "collision_geoms": {
          "patternProperties": {
            "^[a-z][a-z0-9_]{0,31}$": {
              "maxLength": 1000,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            }
          },
          "title": "Collision Geoms",
          "type": "object"
        },
        "free_joint_name": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Free Joint Name"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,31}$",
          "title": "Id",
          "type": "string"
        },
        "motion": {
          "enum": [
            "fixed",
            "free",
            "articulated"
          ],
          "title": "Motion",
          "type": "string"
        }
      },
      "required": [
        "id",
        "body",
        "asset",
        "body_frame",
        "asset_pose_in_body",
        "collision_geoms",
        "motion",
        "free_joint_name"
      ],
      "title": "_Object",
      "type": "object"
    },
    "_ObjectState": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[a-z][a-z0-9_]{0,31}$",
          "title": "Object Id",
          "type": "string"
        },
        "pose": {
          "$ref": "#/$defs/_Pose"
        }
      },
      "required": [
        "object_id",
        "pose"
      ],
      "title": "_ObjectState",
      "type": "object"
    },
    "_Physics": {
      "additionalProperties": false,
      "description": "Mass/COM/full inertia in asset frame; contact properties per collision part.",
      "properties": {
        "center_of_mass_m": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Center Of Mass M",
          "type": "array"
        },
        "contacts": {
          "patternProperties": {
            "^[a-z][a-z0-9_]{0,31}$": {
              "$ref": "#/$defs/_ContactPhysics"
            }
          },
          "title": "Contacts",
          "type": "object"
        },
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "inertia_kg_m2": {
          "items": {
            "type": "number"
          },
          "maxItems": 6,
          "minItems": 6,
          "title": "Inertia Kg M2",
          "type": "array"
        },
        "mass_kg": {
          "minimum": 0,
          "title": "Mass Kg",
          "type": "number"
        }
      },
      "required": [
        "digest",
        "mass_kg",
        "center_of_mass_m",
        "inertia_kg_m2",
        "contacts"
      ],
      "title": "_Physics",
      "type": "object"
    },
    "_PlatformGroup": {
      "additionalProperties": false,
      "description": "Exact trusted platform geom groups, never author-overridable target aliases.",
      "properties": {
        "body": {
          "maxLength": 1000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Body",
          "type": "string"
        },
        "collision_geoms": {
          "items": {
            "maxLength": 1000,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 1,
          "title": "Collision Geoms",
          "type": "array"
        },
        "id": {
          "enum": [
            "table",
            "robot"
          ],
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "body",
        "collision_geoms"
      ],
      "title": "_PlatformGroup",
      "type": "object"
    },
    "_Pose": {
      "additionalProperties": false,
      "description": "World coordinates in metres and an xyzw quaternion; MJCF uses wxyz.",
      "properties": {
        "position_m": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Position M",
          "type": "array"
        },
        "quaternion_xyzw": {
          "items": {
            "type": "number"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Quaternion Xyzw",
          "type": "array"
        }
      },
      "required": [
        "position_m",
        "quaternion_xyzw"
      ],
      "title": "_Pose",
      "type": "object"
    },
    "_Provenance": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "license": {
          "maxLength": 1000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "License",
          "type": "string"
        },
        "source": {
          "maxLength": 1000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Source",
          "type": "string"
        },
        "source_revision": {
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
          "title": "Source Revision",
          "type": "string"
        }
      },
      "required": [
        "digest",
        "source",
        "source_revision",
        "license"
      ],
      "title": "_Provenance",
      "type": "object"
    },
    "_Robot": {
      "additionalProperties": false,
      "description": "Platform robot bytes and tool/control mapping must match the registry.",
      "properties": {
        "artifact": {
          "$ref": "#/$defs/_ExactRef"
        },
        "control_mapping": {
          "$ref": "#/$defs/_ExactRef"
        },
        "mount": {
          "$ref": "#/$defs/_Pose"
        }
      },
      "required": [
        "artifact",
        "control_mapping",
        "mount"
      ],
      "title": "_Robot",
      "type": "object"
    },
    "_Scene": {
      "additionalProperties": false,
      "description": "A closed DAG of local files; no runtime URL resolution or robot replacement.",
      "properties": {
        "assets": {
          "items": {
            "$ref": "#/$defs/_Asset"
          },
          "minItems": 1,
          "title": "Assets",
          "type": "array"
        },
        "camera": {
          "$ref": "#/$defs/_Camera"
        },
        "contact_targets": {
          "items": {
            "$ref": "#/$defs/_ContactTarget"
          },
          "title": "Contact Targets",
          "type": "array"
        },
        "coordinates": {
          "const": "right_handed_z_up_xyzw",
          "title": "Coordinates",
          "type": "string"
        },
        "dependencies": {
          "items": {
            "$ref": "#/$defs/_Dependency"
          },
          "minItems": 1,
          "title": "Dependencies",
          "type": "array"
        },
        "entrypoint": {
          "title": "Entrypoint",
          "type": "string"
        },
        "frames": {
          "items": {
            "$ref": "#/$defs/_Frame"
          },
          "minItems": 1,
          "title": "Frames",
          "type": "array"
        },
        "initial_states": {
          "items": {
            "$ref": "#/$defs/_InitialState"
          },
          "minItems": 1,
          "title": "Initial States",
          "type": "array"
        },
        "joints": {
          "items": {
            "$ref": "#/$defs/_Joint"
          },
          "title": "Joints",
          "type": "array"
        },
        "platform_groups": {
          "items": {
            "$ref": "#/$defs/_PlatformGroup"
          },
          "title": "Platform Groups",
          "type": "array"
        },
        "units": {
          "const": "metres_radians",
          "title": "Units",
          "type": "string"
        }
      },
      "required": [
        "entrypoint",
        "dependencies",
        "joints",
        "assets",
        "frames",
        "platform_groups",
        "contact_targets",
        "camera",
        "initial_states",
        "units",
        "coordinates"
      ],
      "title": "_Scene",
      "type": "object"
    },
    "_Stage": {
      "additionalProperties": false,
      "description": "The OPE-227 AST is validated by validate_program, including early rejection.",
      "properties": {
        "goal": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Goal",
          "type": "object"
        },
        "hold_ticks": {
          "title": "Hold Ticks",
          "type": "integer"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,31}$",
          "title": "Id",
          "type": "string"
        },
        "invariants": {
          "items": {
            "additionalProperties": {
              "$ref": "#/$defs/JsonValue"
            },
            "type": "object"
          },
          "title": "Invariants",
          "type": "array"
        },
        "reject_early": {
          "title": "Reject Early",
          "type": "boolean"
        },
        "requires": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]{0,31}$",
            "type": "string"
          },
          "title": "Requires",
          "type": "array"
        }
      },
      "required": [
        "id",
        "requires",
        "goal",
        "hold_ticks",
        "invariants",
        "reject_early"
      ],
      "title": "_Stage",
      "type": "object"
    },
    "_Symmetry": {
      "additionalProperties": false,
      "description": "Explicit proper rotation group or continuous axis, verified against geometry.",
      "properties": {
        "axis_xyz": {
          "anyOf": [
